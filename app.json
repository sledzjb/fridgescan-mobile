{
  "expo": {
    "name": "FridgeScan",
    "slug": "fridgescan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#50D494",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/fridgescan-mobile"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "FridgeScan używa aparatu, żeby zrobić zdjęcie wnętrza lodówki i rozpoznać produkty."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FridgeScan potrzebuje dostępu do zdjęć, żeby wybrać fotografię lodówki z galerii."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3F5C1C"
        }
      ]
    ]
  }
}
